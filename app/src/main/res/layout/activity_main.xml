<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#FFFFFF">

    <!-- Base del tablero -->
    <View
        android:id="@+id/tableroBase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"/>

    <!-- Esquinas -->
    <TextView
        android:id="@+id/casillaSalida"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#00FF00"
        android:text="Salida"
        android:textColor="#000000"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toStartOf="@id/tableroBase"/>

    <TextView
        android:id="@+id/casillaCarcel"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#808080"
        android:text="Cárcel"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintEnd_toEndOf="@id/tableroBase"/>

    <TextView
        android:id="@+id/casillaParking"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#00FF00"
        android:text="Parking"
        android:textColor="#000000"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintEnd_toEndOf="@id/tableroBase"/>

    <TextView
        android:id="@+id/casillaVeCarcel"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#FFA500"
        android:text="Ve a la cárcel"
        android:textColor="#000000"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toStartOf="@id/tableroBase"/>

    <!-- Fila inferior de propiedades (7 casillas entre Salida y Cárcel) -->
    <FrameLayout
        android:id="@+id/casilla1"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casillaSalida"
        app:layout_constraintEnd_toStartOf="@id/casilla2"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000080"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Museo del Padro"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla2"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla1"
        app:layout_constraintEnd_toStartOf="@id/casilla3"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8B0000"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Gran Vía"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla3"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla2"
        app:layout_constraintEnd_toStartOf="@id/casilla4"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF8C00"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Estación de Tren"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla4"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla3"
        app:layout_constraintEnd_toStartOf="@id/casilla5"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#006400"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="La Elipa"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla5"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla4"
        app:layout_constraintEnd_toStartOf="@id/casilla6"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00CED1"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Av. de Bravo Murillo"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla6"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla5"
        app:layout_constraintEnd_toStartOf="@id/casilla7"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFD700"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Electricidad y Agua"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla7"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla6"
        app:layout_constraintEnd_toStartOf="@id/casillaCarcel"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF1493"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Garcia Noblejas"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <!-- Fila superior de propiedades (7 casillas entre Ve a la cárcel y Parking) -->
    <FrameLayout
        android:id="@+id/casilla8"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casillaVeCarcel"
        app:layout_constraintEnd_toStartOf="@id/casilla9"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00CED1"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Av. de Bravo Murillo"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla9"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla8"
        app:layout_constraintEnd_toStartOf="@id/casilla10"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFD700"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Electricidad y Agua"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla10"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla9"
        app:layout_constraintEnd_toStartOf="@id/casilla11"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF1493"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Garcia Noblejas"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla11"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla10"
        app:layout_constraintEnd_toStartOf="@id/casilla12"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8B0000"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Gran Vía"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla12"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla11"
        app:layout_constraintEnd_toStartOf="@id/casilla13"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF8C00"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Estación de Tren"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla13"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla12"
        app:layout_constraintEnd_toStartOf="@id/casilla14"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#006400"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="La Elipa"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/casilla14"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tableroBase"
        app:layout_constraintStart_toEndOf="@id/casilla13"
        app:layout_constraintEnd_toStartOf="@id/casillaParking"
        app:layout_constraintHorizontal_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000080"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Museo del Prado"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <!-- Columnas laterales de propiedades -->
    <FrameLayout
        android:id="@+id/casillaIzquierda1"
        android:layout_width="60dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/casillaVeCarcel"
        app:layout_constraintBottom_toTopOf="@id/casilla1"
        app:layout_constraintStart_toStartOf="@id/tableroBase"
        app:layout_constraintVertical_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D2B48C"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Ronda de Valencia"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    
    <FrameLayout
        android:id="@+id/casillaDerecha1"
        android:layout_width="60dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/casillaParking"
        app:layout_constraintBottom_toTopOf="@id/casillaCarcel"
        app:layout_constraintEnd_toEndOf="@id/tableroBase"
        app:layout_constraintVertical_weight="1">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF4500"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Avenida de la Albufera"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="10sp"/>
    </FrameLayout>

    <!-- Casillas especiales intermedias -->
    <TextView
        android:id="@+id/casillaImpuesto"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#AAAAAA"
        android:text="Impuesto"
        android:gravity="center"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@id/casilla1"
        app:layout_constraintStart_toEndOf="@id/casilla2"
        app:layout_constraintEnd_toStartOf="@id/casilla3"
        app:layout_constraintHorizontal_weight="1"/>

    <TextView
        android:id="@+id/casillaSuerte"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="#00AAAA"
        android:text="Suerte"
        android:gravity="center"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/casilla8"
        app:layout_constraintStart_toEndOf="@id/casilla9"
        app:layout_constraintEnd_toStartOf="@id/casilla10"
        app:layout_constraintHorizontal_weight="1"/>

</androidx.constraintlayout.widget.ConstraintLayout>